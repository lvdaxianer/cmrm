{
  "name": "cmrm",
  "version": "0.2.0",
  "description": "CLI tool to manage and switch Claude CLI model configurations",
  "main": "dist/cli.js",
  "bin": {
    "cmrm": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=es2017 --outfile=dist/cli.js --minify --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
    "build:dev": "esbuild src/cli.ts --bundle --platform=node --target=es2017 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvdaxianer/cmrm.git"
  },
  "bugs": {
    "url": "https://github.com/lvdaxianer/cmrm/issues"
  },
  "homepage": "https://github.com/lvdaxianer/cmrm",
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "model",
    "switch",
    "cli",
    "claude",
    "registry",
    "config"
  ],
  "author": "lvdaxianer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@types/inquirer": "^9.0.9",
    "chalk": "^4.1.2",
    "inquirer": "^13.4.2"
  }
}
